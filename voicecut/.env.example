# Copy this file to .env and fill in values as needed:
#   cp voicecut/.env.example voicecut/.env

# SQLite is the default. Use an absolute path in Docker.
DATABASE_URL=sqlite:///./data/voicecut.db
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

# LLM keys are optional at startup. Required only for chapter / viral-clip generation.
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Vite dev-server proxy target (frontend only)
API_TARGET=http://localhost:8000

# Disable Hugging Face hub / dataset / transformers network calls (tests and CI).
HF_DATASETS_OFFLINE=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
