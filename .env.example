# Copy to voicecut/.env (or use this file from the repo root):
#   cp .env.example voicecut/.env

DATABASE_URL=sqlite:///./data/voicecut.db
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

API_TARGET=http://localhost:8000

# Disable Hugging Face hub / dataset / transformers network calls (tests and CI).
HF_DATASETS_OFFLINE=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
