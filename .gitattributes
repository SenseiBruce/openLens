*.mp4 filter=lfs diff=lfs merge=lfs -text

# Force LF line endings for shell scripts (prevents CRLF breakage on macOS/Linux)
*.sh text eol=lf

# Standard text files — normalize on checkout
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.env text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.whl binary
*.pyc binary
