# ============================================================================
# Docker Compose Multi-Service Deployment Template
# Version: 1.0
# Last Updated: 2026-02-09
# ============================================================================
# This template provides a comprehensive multi-service Docker deployment
# configuration with database, cache, application, and reverse proxy services.
# ============================================================================

version: '3.8'

# ============================================================================
# Networks Configuration
# ============================================================================
networks:
  # Frontend network for public-facing services
  frontend:
    driver: bridge
    ipam:
      config:
        - subnet: 172.20.0.0/16
          
  # Backend network for internal services
  backend:
    driver: bridge
    internal: true  # No external access
    ipam:
      config:
        - subnet: 172.21.0.0/16

# ============================================================================
# Volumes Configuration
# ============================================================================
volumes:
  # PostgreSQL data persistence
  postgres_data:
    driver: local
    
  # MySQL data persistence
  mysql_data:
    driver: local
    
  # Redis data persistence
  redis_data:
    driver: local
    
  # Application uploads
  app_uploads:
    driver: local
    
  # Nginx configuration
  nginx_conf:
    driver: local
    
  # SSL certificates
  ssl_certs:
    driver: local
    
  # Application logs
  app_logs:
    driver: local

# ============================================================================
# Services Configuration
# ============================================================================
services:

  # ==========================================================================
  # PostgreSQL Database Service
  # ==========================================================================
  postgres:
    image: postgres:15-alpine
    container_name: postgres_db
    restart: unless-stopped
    
    # Environment variables
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-admin}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-changeme}
      POSTGRES_DB: ${POSTGRES_DB:-application}
      POSTGRES_INITDB_ARGS: "--encoding=UTF-8 --lc-collate=C --lc-ctype=C"
      PGDATA: /var/lib/postgresql/data/pgdata
      
    # Volumes
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./init-scripts/postgres:/docker-entrypoint-initdb.d:ro
      - ./backups/postgres:/backups
      
    # Ports (internal only)
    expose:
      - "5432"
      
    # Networks
    networks:
      - backend
      
    # Health check
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-admin} -d ${POSTGRES_DB:-application}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
      
    # Resource limits
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2G
        reservations:
          cpus: '1.0'
          memory: 1G
          
    # Logging
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # ==========================================================================
  # MySQL Database Service (Alternative)
  # ==========================================================================
  mysql:
    image: mysql:8.0
    container_name: mysql_db
    restart: unless-stopped
    
    # Environment variables
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:-rootpassword}
      MYSQL_DATABASE: ${MYSQL_DATABASE:-application}
      MYSQL_USER: ${MYSQL_USER:-appuser}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD:-changeme}
      
    # Volumes
    volumes:
      - mysql_data:/var/lib/mysql
      - ./init-scripts/mysql:/docker-entrypoint-initdb.d:ro
      - ./config/mysql/my.cnf:/etc/mysql/conf.d/custom.cnf:ro
      
    # Ports
    expose:
      - "3306"
      
    # Networks
    networks:
      - backend
      
    # Health check
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "root", "-p${MYSQL_ROOT_PASSWORD:-rootpassword}"]
      interval: 10s
      timeout: 5s
      retries: 5
      
    # Resource limits
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2G
        reservations:
          cpus: '1.0'
          memory: 1G
          
    # Command overrides
    command: 
      - --default-authentication-plugin=mysql_native_password
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci

  # ==========================================================================
  # Redis Cache Service
  # ==========================================================================
  redis:
    image: redis:7-alpine
    container_name: redis_cache
    restart: unless-stopped
    
    # Command with authentication
    command: redis-server --requirepass ${REDIS_PASSWORD:-changeme} --maxmemory 512mb --maxmemory-policy allkeys-lru
    
    # Volumes
    volumes:
      - redis_data:/data
      - ./config/redis/redis.conf:/usr/local/etc/redis/redis.conf:ro
      
    # Ports
    expose:
      - "6379"
      
    # Networks
    networks:
      - backend
      
    # Health check
    healthcheck:
      test: ["CMD", "redis-cli", "--raw", "incr", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      
    # Resource limits
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 512M
        reservations:
          cpus: '0.5'
          memory: 256M

  # ==========================================================================
  # Backend API Service
  # ==========================================================================
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
      args:
        NODE_ENV: production
        BUILD_DATE: ${BUILD_DATE}
        VERSION: ${VERSION:-1.0.0}
    container_name: backend_api
    restart: unless-stopped
    
    # Environment variables
    environment:
      NODE_ENV: production
      PORT: 3000
      
      # Database configuration
      DB_HOST: postgres
      DB_PORT: 5432
      DB_NAME: ${POSTGRES_DB:-application}
      DB_USER: ${POSTGRES_USER:-admin}
      DB_PASSWORD: ${POSTGRES_PASSWORD:-changeme}
      
      # Redis configuration
      REDIS_HOST: redis
      REDIS_PORT: 6379
      REDIS_PASSWORD: ${REDIS_PASSWORD:-changeme}
      
      # Application configuration
      JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
      API_KEY: ${API_KEY:-your-api-key}
      LOG_LEVEL: ${LOG_LEVEL:-info}
      
    # Volumes
    volumes:
      - app_uploads:/app/uploads
      - app_logs:/app/logs
      - ./config/backend:/app/config:ro
      
    # Ports
    expose:
      - "3000"
      
    # Networks
    networks:
      - frontend
      - backend
      
    # Dependencies
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
        
    # Health check
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
      
    # Resource limits
    deploy:
      replicas: 2
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
        reservations:
          cpus: '0.5'
          memory: 512M
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
        
    # Logging
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "5"

  # ==========================================================================
  # Frontend Web Application Service
  # ==========================================================================
  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
      args:
        REACT_APP_API_URL: ${API_URL:-http://backend:3000}
        NODE_ENV: production
    container_name: frontend_web
    restart: unless-stopped
    
    # Environment variables
    environment:
      REACT_APP_API_URL: http://backend:3000
      NODE_ENV: production
      
    # Volumes
    volumes:
      - ./config/frontend/nginx.conf:/etc/nginx/nginx.conf:ro
      
    # Ports
    expose:
      - "80"
      
    # Networks
    networks:
      - frontend
      
    # Dependencies
    depends_on:
      - backend
      
    # Health check
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:80"]
      interval: 30s
      timeout: 10s
      retries: 3
      
    # Resource limits
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 256M

  # ==========================================================================
  # Worker Service (Background Jobs)
  # ==========================================================================
  worker:
    build:
      context: ./backend
      dockerfile: Dockerfile.worker
    container_name: backend_worker
    restart: unless-stopped
    
    # Command override
    command: npm run worker
    
    # Environment variables
    environment:
      NODE_ENV: production
      
      # Database configuration
      DB_HOST: postgres
      DB_PORT: 5432
      DB_NAME: ${POSTGRES_DB:-application}
      DB_USER: ${POSTGRES_USER:-admin}
      DB_PASSWORD: ${POSTGRES_PASSWORD:-changeme}
      
      # Redis configuration
      REDIS_HOST: redis
      REDIS_PORT: 6379
      REDIS_PASSWORD: ${REDIS_PASSWORD:-changeme}
      
      # Worker configuration
      WORKER_CONCURRENCY: ${WORKER_CONCURRENCY:-5}
      
    # Volumes
    volumes:
      - app_logs:/app/logs
      
    # Networks
    networks:
      - backend
      
    # Dependencies
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
        
    # Resource limits
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
        reservations:
          cpus: '0.5'
          memory: 512M

  # ==========================================================================
  # Nginx Reverse Proxy
  # ==========================================================================
  nginx:
    image: nginx:alpine
    container_name: nginx_proxy
    restart: unless-stopped
    
    # Ports
    ports:
      - "${HTTP_PORT:-80}:80"
      - "${HTTPS_PORT:-443}:443"
      
    # Volumes
    volumes:
      - ./config/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./config/nginx/conf.d:/etc/nginx/conf.d:ro
      - ssl_certs:/etc/nginx/ssl:ro
      - app_uploads:/var/www/uploads:ro
      
    # Networks
    networks:
      - frontend
      
    # Dependencies
    depends_on:
      - frontend
      - backend
      
    # Health check
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:80/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      
    # Resource limits
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
        reservations:
          cpus: '0.25'
          memory: 128M
          
    # Logging
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  # ==========================================================================
  # Adminer (Database Management UI) - Optional
  # ==========================================================================
  adminer:
    image: adminer:latest
    container_name: adminer
    restart: unless-stopped
    
    # Ports (only expose in development)
    ports:
      - "8080:8080"
      
    # Networks
    networks:
      - backend
      
    # Environment variables
    environment:
      ADMINER_DEFAULT_SERVER: postgres
      ADMINER_DESIGN: pepa-linha
      
    # Dependencies
    depends_on:
      - postgres
      - mysql
      
    # Resource limits
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: 128M

# ============================================================================
# Additional Configuration Notes
# ============================================================================
# 
# To use this template:
# 1. Copy this file to docker-compose.yml
# 2. Create a .env file with your environment variables
# 3. Create necessary configuration directories:
#    - ./config/nginx/
#    - ./config/redis/
#    - ./config/mysql/
#    - ./config/backend/
#    - ./init-scripts/postgres/
#    - ./init-scripts/mysql/
# 4. Run: docker-compose up -d
# 
# Environment variables to set in .env:
# - POSTGRES_PASSWORD
# - MYSQL_ROOT_PASSWORD
# - REDIS_PASSWORD
# - JWT_SECRET
# - API_KEY
# 
# ============================================================================
